        "validation_timeout_ms": {
          "default": 5000,
          "maximum": 30000,
          "minimum": 10,
          "title": "Validation Timeout Ms",
          "type": "integer"
        },
        "max_response_bytes": {
          "default": 1000000,
          "maximum": 5000000,
          "minimum": 64,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "max_cases": {
          "default": 256,
          "maximum": 1024,
          "minimum": 1,
          "title": "Max Cases",
          "type": "integer"
        }
      },
      "required": [
        "base_url"
      ],
      "title": "API",
      "type": "object"
    },
    "Allow": {
      "additionalProperties": false,
      "properties": {
        "role": {
