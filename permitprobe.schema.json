    "LinkedResource": {
      "additionalProperties": false,
      "description": "Status-only alternate read tied to a protected source object.",
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "source_resource": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Source Resource",
          "type": "string"
        },
        "origin": {
          "maxLength": 512,
          "title": "Origin",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "authentication": {
          "default": "anonymous",
          "enum": [
            "anonymous",
            "source_subjects"
          ],
          "title": "Authentication",
          "type": "string"
