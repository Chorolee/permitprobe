        "deny": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Deny",
          "type": "array"
        },
        "max_file_bytes": {
          "default": 1000000,
          "maximum": 5000000,
          "minimum": 1,
          "title": "Max File Bytes",
          "type": "integer"
        },
        "max_total_bytes": {
          "default": 10000000,
          "maximum": 50000000,
          "minimum": 1,
          "title": "Max Total Bytes",
          "type": "integer"
