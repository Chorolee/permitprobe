        "subjects": {
          "items": {
            "$ref": "#/$defs/Subject"
          },
          "maxItems": 16,
          "title": "Subjects",
          "type": "array"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "maxItems": 32,
          "title": "Resources",
          "type": "array"
        },
        "linked_resources": {
          "items": {
            "$ref": "#/$defs/LinkedResource"
          },
          "maxItems": 32,
          "title": "Linked Resources",
          "type": "array"
        },
        "public_resources": {
          "items": {
            "$ref": "#/$defs/PublicResource"
          },
          "maxItems": 32,
          "title": "Public Resources",
          "type": "array"
        },
        "exploration_resources": {
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "maxItems": 32,
          "title": "Exploration Resources",
          "type": "array"
