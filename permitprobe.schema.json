          "default": true,
          "title": "Include Robots",
          "type": "boolean"
        },
        "include_sitemap": {
          "default": true,
          "title": "Include Sitemap",
          "type": "boolean"
        },
        "report_path_literals": {
          "items": {
            "type": "string"
          },
          "maxItems": 128,
          "title": "Report Path Literals",
          "type": "array"
        },
        "report_query_names": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Report Query Names",
          "type": "array"
        },
        "max_candidates": {
          "default": 128,
          "maximum": 512,
          "minimum": 1,
          "title": "Max Candidates",
          "type": "integer"
        },
        "max_response_bytes": {
          "default": 262144,
          "maximum": 1000000,
          "minimum": 1024,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 5,
          "maximum": 15,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "Discovery",
      "type": "object"
    },
    "HSTSContract": {
      "additionalProperties": false,
      "properties": {
        "min_max_age": {
          "default": 31536000,
          "maximum": 63072000,
          "minimum": 0,
          "title": "Min Max Age",
          "type": "integer"
        },
        "include_subdomains": {
          "default": false,
          "title": "Include Subdomains",
          "type": "boolean"
        },
        "preload": {
          "default": false,
          "title": "Preload",
          "type": "boolean"
        }
      },
      "title": "HSTSContract",
      "type": "object"
    },
    "Handoff": {
      "additionalProperties": false,
      "properties": {
        "root": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Root",
          "type": "string"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "allow": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Allow",
          "type": "array"
