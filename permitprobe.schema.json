            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Attr"
        },
        "item_pointer": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Pointer"
        },
        "items_attr": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Items Attr"
        }
      },
      "required": [
        "items_pointer"
      ],
      "title": "Collection",
      "type": "object"
    },
    "Discovery": {
      "additionalProperties": false,
      "description": "Fixed anonymous sources used only to propose same-origin GET coverage.",
      "properties": {
        "seed_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Seed Paths",
          "type": "array"
