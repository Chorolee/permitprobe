            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxProperties": 32,
          "minProperties": 1,
          "title": "Required Directives",
          "type": "object"
        }
      },
      "required": [
        "required_directives"
      ],
      "title": "CSPContract",
      "type": "object"
    },
    "Collection": {
      "additionalProperties": false,
      "properties": {
        "items_pointer": {
          "maxLength": 512,
          "title": "Items Pointer",
          "type": "string"
        },
        "owner_pointer": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
