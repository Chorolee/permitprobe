{
  "$defs": {
    "API": {
      "additionalProperties": false,
      "properties": {
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "subjects": {
          "items": {
            "$ref": "#/$defs/Subject"
          },
          "maxItems": 16,
          "minItems": 3,
          "title": "Subjects",
          "type": "array"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Resources",
          "type": "array"
        },
        "exploration_resources": {
          "items": {
            "$ref": "#/$defs/Resource"
          },
          "maxItems": 32,
          "title": "Exploration Resources",
          "type": "array"
        },
        "probe_victims": {
          "default": "all",
          "enum": [
            "one",
            "all"
          ],
          "title": "Probe Victims",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 5,
          "maximum": 30,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        },
        "max_response_bytes": {
          "default": 1000000,
          "maximum": 5000000,
          "minimum": 64,
          "title": "Max Response Bytes",
          "type": "integer"
        },
        "max_cases": {
          "default": 256,
          "maximum": 1024,
          "minimum": 1,
          "title": "Max Cases",
          "type": "integer"
        }
      },
      "required": [
        "base_url",
        "subjects",
        "resources"
      ],
      "title": "API",
      "type": "object"
    },
    "Allow": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Role",
          "type": "string"
        },
        "scope": {
          "default": "any",
          "enum": [
            "own",
            "any"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "role"
      ],
      "title": "Allow",
      "type": "object"
    },
    "Collection": {
      "additionalProperties": false,
      "properties": {
        "items_pointer": {
          "maxLength": 512,
          "title": "Items Pointer",
          "type": "string"
        },
        "owner_pointer": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Pointer"
        },
        "owner_attr": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Attr"
        },
        "item_pointer": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Pointer"
        },
        "items_attr": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Items Attr"
        }
      },
      "required": [
        "items_pointer"
      ],
      "title": "Collection",
      "type": "object"
    },
    "Handoff": {
      "additionalProperties": false,
      "properties": {
        "root": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Root",
          "type": "string"
        },
        "files": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "allow": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Allow",
          "type": "array"
        },
        "deny": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Deny",
          "type": "array"
        },
        "max_file_bytes": {
          "default": 1000000,
          "maximum": 5000000,
          "minimum": 1,
          "title": "Max File Bytes",
          "type": "integer"
        },
        "max_total_bytes": {
          "default": 10000000,
          "maximum": 50000000,
          "minimum": 1,
          "title": "Max Total Bytes",
          "type": "integer"
        }
      },
      "required": [
        "root",
        "files",
        "allow"
      ],
      "title": "Handoff",
      "type": "object"
    },
    "Redirect": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": 302,
          "enum": [
            302,
            303,
            307,
            308
          ],
          "title": "Status",
          "type": "integer"
        },
        "origin": {
          "maxLength": 512,
          "title": "Origin",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "required_query": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Required Query",
          "type": "array"
        }
      },
      "required": [
        "origin",
        "path",
        "required_query"
      ],
      "title": "Redirect",
      "type": "object"
    },
    "Resource": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "path": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "default": "object",
          "enum": [
            "object",
            "function"
          ],
          "title": "Kind",
          "type": "string"
        },
        "owner_param": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Param"
        },
        "owner_attr": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Owner Attr"
        },
        "identity_pointer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Pointer"
        },
        "collection": {
          "anyOf": [
            {
              "$ref": "#/$defs/Collection"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "redirect": {
          "anyOf": [
            {
              "$ref": "#/$defs/Redirect"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "private_cache": {
          "default": false,
          "title": "Private Cache",
          "type": "boolean"
        },
        "allow": {
          "items": {
            "$ref": "#/$defs/Allow"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Allow",
          "type": "array"
        },
        "response_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Schema"
        },
        "denial_schema": {
          "additionalProperties": true,
          "title": "Denial Schema",
          "type": "object"
        }
      },
      "required": [
        "name",
        "path",
        "allow",
        "denial_schema"
      ],
      "title": "Resource",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "role": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
          "title": "Role",
          "type": "string"
        },
        "token_env": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Token Env"
        },
        "cookie_env": {
          "anyOf": [
            {
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cookie Env"
        },
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "owned_items": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "maxProperties": 32,
          "title": "Owned Items",
          "type": "object"
        },
        "marker": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Marker"
        }
      },
      "required": [
        "name",
        "role"
      ],
      "title": "Subject",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "api": {
      "anyOf": [
        {
          "$ref": "#/$defs/API"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "handoff": {
      "anyOf": [
        {
          "$ref": "#/$defs/Handoff"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "version"
  ],
  "title": "Policy",
  "type": "object"
}
