{
  "version": 1,
  "api": {
    "base_url": "https://staging.example.invalid",
    "timeout_seconds": 5,
    "public_resources": [
      {
        "name": "case-survey",
        "path": "/api/cases/survey",
        "lifecycle": "active",
        "query": [
          {
            "name": "case",
            "value": "synthetic-case"
          },
          {
            "name": "court",
            "value": "synthetic-court"
          },
          {
            "name": "mode",
            "value": "current"
          }
        ],
        "variants": [
          {
            "name": "default"
          },
          {
            "name": "session-shaped",
            "header_envs": {
              "Cookie": "PP_SYNTHETIC_ATTACKER_COOKIE"
            }
          },
          {
            "name": "trusted-origin",
            "header_envs": {
              "Origin": "PP_TRUSTED_ORIGIN"
            }
          },
          {
            "name": "hostile-origin",
            "header_envs": {
              "Origin": "PP_HOSTILE_ORIGIN"
            }
          }
        ],
        "expected_statuses": [
          200
        ],
        "max_elapsed_ms": 1000,
        "cache": "no-store",
        "response_schema": {
          "type": "object",
          "required": [
            "state"
          ],
          "properties": {
            "state": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "response_security": {
          "security_headers": {
            "hsts": {
              "min_max_age": 31536000,
              "include_subdomains": true,
              "preload": false
            },
            "content_type_options": "nosniff",
            "referrer_policy": [
              "strict-origin-when-cross-origin",
              "no-referrer"
            ],
            "frame_options": [
              "deny"
            ],
            "content_security_policy": {
              "required_directives": {
                "default-src": [
                  "'none'"
                ],
                "frame-ancestors": [
                  "'none'"
                ]
              }
            },
            "cross_origin_opener_policy": [
              "same-origin"
            ],
            "cross_origin_embedder_policy": [
              "require-corp"
            ],
            "cross_origin_resource_policy": [
              "same-origin"
            ],
            "origin_agent_cluster": true
          },
          "cookies": [
            {
              "name": "__Host-session",
              "secure": true,
              "http_only": true,
              "same_site": [
                "strict",
                "lax"
              ],
              "host_only": true,
              "path": "/"
            }
          ],
          "cors": {
            "allow_variants": [
              "trusted-origin"
            ],
            "deny_variants": [
              "hostile-origin"
            ],
            "allow_credentials": true,
            "allow_wildcard": false,
            "require_vary_origin": true
          }
        }
      },
      {
        "name": "retired-account-page",
        "path": "/account",
        "lifecycle": "retired",
        "expected_statuses": [
          307,
          404,
          410,
          503
        ],
        "max_elapsed_ms": 500
      }
    ]
  }
}
