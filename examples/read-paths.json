          },
          {
            "role": "moderator",
            "scope": "any"
          },
          {
            "role": "admin",
            "scope": "any"
          }
        ],
        "collection": {
          "items_pointer": "/items",
          "item_pointer": "/id",
          "items_attr": "requests"
        },
        "response_schema": {
          "type": "object",
          "required": [
            "items"
          ],
          "additionalProperties": false,
          "properties": {
