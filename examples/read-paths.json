{
  "version": 1,
  "api": {
    "base_url": "https://staging.example.invalid",
    "probe_victims": "all",
    "subjects": [
      {
        "name": "anon",
        "role": "anonymous"
      },
      {
        "name": "alice",
        "role": "member",
        "cookie_env": "PP_ALICE_COOKIE",
        "attributes": {
          "user_id": "alice"
        },
        "owned_items": {
          "requests": [
            "request-alice"
          ]
        }
      },
      {
        "name": "bob",
        "role": "member",
        "cookie_env": "PP_BOB_COOKIE",
        "attributes": {
          "user_id": "bob"
        },
        "owned_items": {
          "requests": [
            "request-bob"
          ]
        }
      },
      {
        "name": "moderator",
        "role": "moderator",
        "cookie_env": "PP_MODERATOR_COOKIE",
