    ],
    "resources": [
      {
        "name": "private-attachments",
        "path": "/attachments/{id}/private.png",
        "kind": "object",
        "owner_param": "id",
        "owner_attr": "user_id",
        "allow": [
          {
            "role": "member",
            "scope": "own"
          },
          {
            "role": "moderator",
            "scope": "own"
          },
          {
            "role": "admin",
            "scope": "own"
          }
        ],
        "redirect": {
          "status": 302,
          "origin": "https://storage.example.invalid",
          "path": "/signed/attachments/{id}/private.png",
          "required_query": [
            "token"
          ]
        },
        "private_cache": true,
        "denial_schema": {
          "type": "object",
          "required": [
            "error"
          ],
          "additionalProperties": false,
          "properties": {
            "error": {
              "const": "denied"
            }
          }
        }
      },
      {
